PORT=4000

# Connection string for PostgreSQL. When running via docker-compose, "db" is the
# service name of the postgres container (internal port 5432). When running the
# backend directly on your machine against the dockerized database, use localhost:5433
# (see the port mapping in docker-compose.yml).
DATABASE_URL="postgresql://portal_user:portal_pass@localhost:5433/portal_solicitacoes?schema=public"

# Secret used to sign JWT session tokens. Change this to a long random value in production.
JWT_SECRET="troque-este-valor-para-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="8h"

# Origin allowed to call the API with credentials (the frontend URL)
CORS_ORIGIN="http://localhost:5173"

# "development" or "production"
NODE_ENV=development
