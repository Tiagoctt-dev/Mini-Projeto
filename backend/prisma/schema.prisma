// Schema do Portal de Solicitacoes Internas
// Gera as migrations SQL em backend/prisma/migrations e o cliente Prisma usado pela API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Categoria {
  TI
  RH
  COMPRAS
  FINANCEIRO
  INFRAESTRUTURA
}

enum StatusSolicitacao {
  ABERTO
  EM_ATENDIMENTO
  CONCLUIDO
}

model Usuario {
  id           Int           @id @default(autoincrement())
  nome         String        @db.VarChar(120)
  email        String        @unique @db.VarChar(160)
  senhaHash    String        @map("senha_hash") @db.VarChar(255)
  criadoEm     DateTime      @default(now()) @map("criado_em")
  solicitacoes Solicitacao[]

  @@map("usuarios")
}

model Solicitacao {
  id            Int               @id @default(autoincrement())
  titulo        String            @db.VarChar(160)
  descricao     String            @db.Text
  categoria     Categoria
  status        StatusSolicitacao @default(ABERTO)
  solicitanteId Int               @map("solicitante_id")
  solicitante   Usuario           @relation(fields: [solicitanteId], references: [id])
  criadoEm      DateTime          @default(now()) @map("criado_em")
  atualizadoEm  DateTime          @updatedAt @map("atualizado_em")

  @@map("solicitacoes")
  @@index([status])
  @@index([categoria])
  @@index([criadoEm])
}
